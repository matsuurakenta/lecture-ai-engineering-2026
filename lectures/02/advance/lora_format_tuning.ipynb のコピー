列長不足: 最大{max(lengths)}トークン'\n","print('train/valid 最大系列長:', max(lengths))\n","model = AutoModelForCausalLM.from_pretrained(CONFIG['base_model'], revision=CONFIG['revision'], dtype=torch.float32).to(DEVICE)\n","model.config.use_cache = True\n","_ = model.eval()\n","BASE_MEMORY_GB = round(model.get_memory_footprint() / 1e9, 2)\n","print('loaded:', CONFIG['base_model'], '| device:', DEVICE, '| 重みのメモリ(GB):', BASE_MEMORY_GB)\n","def generate(model, example):\n","    # 学習と同じuser質問のみ。goldや正解文は入力しない。\n","    prompt = tok.apply_chat_template(build_messages(example), tokenize=False, add_generation_prompt=True, enable_thinking=False)\n","    inputs = tok(prompt, return_tensors='pt').to(model.device)\n","    with torch.inference_mode():\n","        out = model.generate(**inputs, max_new_tokens=CONFIG['max_new_tokens'], pad_token_id=tok.pad_token_id, **CONFIG['gen'])\n","    return tok.decode(out[0][inputs['input_ids'].shape[1]:], skip_special_tokens=True).strip()"]},{"cell_type":"code","execution_count":null,"id":"d9120ba6","metadata":{"id":"d9120ba6","colab":{"base_uri":"https://localhost:8080/","height":1000},"executionInfo":{"status":"ok","timestamp":1793413080505,"user_tz":-540,"elapsed":245,"user":{"displayName":"松浦健太","userId":"07161653785768738821"}},"outputId":"131918cb-493a-4aa8-e165-fe63c5bf5293"},"outputs":[{"output_type":"stream","name":"stdout","text":["同一データ・同一モデル・同一生成設定の保存済み学習前評価を復元しました。\n"]},{"output_type":"display_data","data":{"text/plain":["                 term_id  \\\n","0                 branch   \n","1                  epoch   \n","2            temperature   \n","3            pretraining   \n","4           quantization   \n","5                     pi   \n","6            fine-tuning   \n","7           fetch-server   \n","8            pydantic-ai   \n","9         context-window   \n","10                 qlora   \n","11                 token   \n","12     human-in-the-loop   \n","13            mcp-config   \n","14       evaluation-loop   \n","15         lec-