b[1;32m    136\u001b[0m         \u001b[0mrequest\u001b[0m\u001b[0;34m=\u001b[0m\u001b[0;34m{\u001b[0m\u001b[0;34m'authType'\u001b[0m\u001b[0;34m:\u001b[0m \u001b[0;34m'dfs_ephemeral'\u001b[0m\u001b[0;34m}\u001b[0m\u001b[0;34m,\u001b[0m\u001b[0;34m\u001b[0m\u001b[0;34m\u001b[0m\u001b[0m\n","\u001b[0;32m/usr/local/lib/python3.13/dist-packages/google/colab/_message.py\u001b[0m in \u001b[0;36mblocking_request\u001b[0;34m(request_type, request, timeout_sec, parent)\u001b[0m\n\u001b[1;32m    174\u001b[0m       \u001b[0mrequest_type\u001b[0m\u001b[0;34m,\u001b[0m \u001b[0mrequest\u001b[0m\u001b[0;34m,\u001b[0m \u001b[0mparent\u001b[0m\u001b[0;34m=\u001b[0m\u001b[0mparent\u001b[0m\u001b[0;34m,\u001b[0m \u001b[0mexpect_reply\u001b[0m\u001b[0;34m=\u001b[0m\u001b[0;32mTrue\u001b[0m\u001b[0;34m\u001b[0m\u001b[0;34m\u001b[0m\u001b[0m\n\u001b[1;32m    175\u001b[0m   )\n\u001b[0;32m--> 176\u001b[0;31m   \u001b[0;32mreturn\u001b[0m \u001b[0mread_reply_from_input\u001b[0m\u001b[0;34m(\u001b[0m\u001b[0mrequest_id\u001b[0m\u001b[0;34m,\u001b[0m \u001b[0mtimeout_sec\u001b[0m\u001b[0;34m)\u001b[0m\u001b[0;34m\u001b[0m\u001b[0;34m\u001b[0m\u001b[0m\n\u001b[0m","\u001b[0;32m/usr/local/lib/python3.13/dist-packages/google/colab/_message.py\u001b[0m in \u001b[0;36mread_reply_from_input\u001b[0;34m(message_id, timeout_sec)\u001b[0m\n\u001b[1;32m    101\u001b[0m     ):\n\u001b[1;32m    102\u001b[0m       \u001b[0;32mif\u001b[0m \u001b[0;34m'error'\u001b[0m \u001b[0;32min\u001b[0m \u001b[0mreply\u001b[0m\u001b[0;34m:\u001b[0m\u001b[0;34m\u001b[0m\u001b[0;34m\u001b[0m\u001b[0m\n\u001b[0;32m--> 103\u001b[0;31m         \u001b[0;32mraise\u001b[0m \u001b[0mMessageError\u001b[0m\u001b[0;34m(\u001b[0m\u001b[0mreply\u001b[0m\u001b[0;34m[\u001b[0m\u001b[0;34m'error'\u001b[0m\u001b[0;34m]\u001b[0m\u001b[0;34m)\u001b[0m\u001b[0;34m\u001b[0m\u001b[0;34m\u001b[0m\u001b[0m\n\u001b[0m\u001b[1;32m    104\u001b[0m       \u001b[0;32mreturn\u001b[0m \u001b[0mreply\u001b[0m\u001b[0;34m.\u001b[0m\u001b[0mget\u001b[0m\u001b[0;34m(\u001b[0m\u001b[0;34m'data'\u001b[0m\u001b[0;34m,\u001b[0m \u001b[0;32mNone\u001b[0m\u001b[0;34m)\u001b[0m\u001b[0;34m\u001b[0m\u001b[0;34m\u001b[0m\u001b[0m\n\u001b[1;32m    105\u001b[0m \u001b[0;34m\u001b[0m\u001b[0m\n","\u001b[0;31mMessageError\u001b[0m: Error: credential propagation was unsuccessful"]}]},{"cell_type":"markdown","id":"6c3e3709","metadata":{"id":"6c3e3709"},"source":["## 2. 作成済みデータの読み込みと確認\n","\n","train/valid のmessagesをそのまま読み込みます。testは質問だけ、goldは採点用の正解です。デフォルトFAQデータは生成しません。\n","\n","スキーマ、testとgoldの対応、正規化後の質問重複を確認し、入力ファイルのSHA-256とコピーを結果フォルダに保存します。"]},{"cell_type":"code","execution_count":null,"id":"9ea1a92c","metadata":{"id":"9ea1a92c","colab":{"base_uri":"https://localhost:8080/"},"executionInfo":{"status":"ok","timestamp":1793413032571,"user_tz":-540,"elapsed":32,"user":{"displayName":"松浦健太","userId":"07161653785768738821"}},"outputId":"9c90e3a0-e802-43fd-9baa-62c606bc9acf"},"outputs":[{"output_type":"stream","name":"stdout","text":["DATA_DIR: /content/drive/MyDrive/aie2026/glossary_lora/data_20261031\n","train=464 valid=58 test=58 gold=58\n","質問の重複なし。test/goldは最終評価のみで使用します。\n","学習例: {\"term_id\": \"prompt\", \"messages\": [{\"role\": \"user\", \"content\": \"プロンプトについて簡単に説明してください。\"}, {\"role\": \"assistant\", \"content\": \"LLMに渡す入力文。質問だけでなく、役割、制約、出力形式、例などを含めることで出力を方向づけられる。\"}]}\n","結果の保存先: /content/glossary_lora_20261031_021652\n"]}],"source":["# アップロード済み4ファイルを使用。元ファイルを上書きしない。\n","import hashlib, shutil, unicodedata\n","DATA_DIR = Path(CONFIG['data_dir'])\n","names = ['gold.json', 'test.jsonl', 'train.jsonl', 'valid.jsonl']\n","assert all((DATA_DIR / n).is_file() for n in names), f'4ファイルを {DATA_DIR} に配置してください'\n","def read_jsonl(name):\n","    return [json.loads(line) for line in (DATA_DIR / name).read_text(encoding='utf-8-sig').splitlines() if line.strip()]\n","train, valid, test = [read_jsonl(n) for n in ['train.jsonl', 'valid.jsonl', 'test.jsonl']]\n","gold = json.loads((DATA_DIR / 'gold.json').read_text(encoding='utf-8-sig'))\n","def normalize(text):\n","    return ''.join(unicodedata.normalize('NFKC', text).casefold().split())\n","questions = []\n","for split, rows in [('train', train), ('valid', valid)]:\n","    assert rows, f'{split} が空です'\n","    for row in rows:\n","        messages = row['messages']\n","        assert [m['role'] for m in messages] == ['user', 'assistant']\n","        assert all(isinstance(m['content'], str) and m['content'].strip() for m in messages)\n","        questions.append(normalize(messages[0]['content']))\n","assert test and len(gold) == len(test)\n","for row in test:\n","    assert row['question'] in gold\n","    entry = gold[row['question']]\n","    assert entry['term_id'] == row['term_id']\n","    assert isinstance(entry['answer'], str) and isinstance(entry['must_include'], list)\n","    assert all(isinstance(w, str) and w for w in entry['must_include'])\n","    questions.append(normalize(row['question']))\n","assert len(questions) == len(set(questions)), '分割内または分割間に質問の重複があります'\n","DATA_MANIFEST = {n: {'path': str(DATA_DIR / n), 'sha256': hashlib.sha256((DATA_DIR / n).read_bytes()).hexdigest()} for n in names}\n","for name in names:\n","    shutil.copy2(DATA_DIR / name, WORK / name)\n","(WORK / 'data_manifest.json').write_text(json.dumps(DATA_MANIFEST, indent=2), encoding='utf-8')\n","print('DATA_DIR:', DATA_DIR)\n","print(f'train={len(train)} valid={len(valid)} test={len(test)} gold={len(gold)}')\n","print('質問の重複なし。test/goldは最終評価のみで使用します。')\n","print('学習例:', json.dumps(train[0], ensure_ascii=False))\n","print('結果の保存先:', WORK)"]},{"cell_type":"markdown","id":"98dd3f48","metadata":{"id":"98dd3f48"},"source":["## 3. モデルの読み込みと学習前評価\n","\n","量子化なし・float32で基盤モデルを読み込みます。質問だけをuserメッセージとして渡し、思考モードを無効にして通常の文章を生成します。\n","\n","最大系列長が512トークン以内であることを確認します。学習前の58問の出力と簡易採点を保存します。"]},{"cell_type":"code","execution_count":null,"id":"d7dc2471","metadata":{"id":"d7dc2471","colab":{"base_uri":"https://localhost:8080/","height":85,"referenced_widgets":["711a6abf2a2845bcb997